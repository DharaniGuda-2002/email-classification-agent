# Copy to .env and fill in.

EMAIL_USER=you@gmail.com

# IMAP host — imap.gmail.com for Gmail, imap-mail.outlook.com for Outlook
IMAP_HOST=imap.gmail.com

# SECRET — full access to your mailbox, never commit.
# An app password, NOT your account password: generate one at
# myaccount.google.com/apppasswords (needs 2-Step Verification enabled first).
# Paste with or without spaces; they get stripped.
EMAIL_PASS=abcdefghijklmnop

# Optional: friendly name for the primary account (shown in output)
# EMAIL_NAME=personal

# ─── Multi-account (optional) ───────────────────────────────────────────────
# Add additional accounts with numbered suffixes (1-9). If any EMAIL_USER_N
# is set, the legacy EMAIL_USER/EMAIL_PASS are ignored.
# Each account can have its own IMAP host (defaults to IMAP_HOST).
# EMAIL_USER_1=work@company.com
# EMAIL_PASS_1=qrstuvwxyz123456
# EMAIL_NAME_1=work                # optional, defaults to local-part of email
# EMAIL_HOST_1=imap.gmail.com      # optional, defaults to IMAP_HOST
#
# EMAIL_USER_2=other@domain.com
# EMAIL_PASS_2=...
# EMAIL_NAME_2=other
# EMAIL_HOST_2=imap-mail.outlook.com  # for Outlook/non-Gmail

# LM Studio server
LM_BASE_URL=http://localhost:1234/v1

# Model — must match the loaded model in LM Studio exactly
MODEL=qwen2.5-7b-instruct

# Optional — how far back and how many, per call.
# MAX_EMAILS=50

# Non-Gmail: where the mailbox keeps spam (Outlook uses "Junk").
# SPAM_FOLDER=[Gmail]/Spam

# Mark summarized mail as read so it stops reappearing. Important mail
# (needs-a-reply / high priority) always stays unread. Set false to disable.
# MARK_READ=true
