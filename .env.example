# Copy to .env and fill in.

EMAIL_USER=you@gmail.com

# IMAP host — imap.gmail.com for Gmail, imap-mail.outlook.com for Outlook
IMAP_HOST=imap.gmail.com

# SECRET — full access to your mailbox, never commit.
# An app password, NOT your account password: generate one at
# myaccount.google.com/apppasswords (needs 2-Step Verification enabled first).
# Paste with or without spaces; they get stripped.
EMAIL_PASS=abcdefghijklmnop

# LM Studio server
LM_BASE_URL=http://localhost:1234/v1

# Model — must match the loaded model in LM Studio exactly
MODEL=qwen2.5-7b-instruct

# Optional — how far back and how many, per call.
# MAX_EMAILS=50

# Non-Gmail: where the mailbox keeps spam (Outlook uses "Junk").
# SPAM_FOLDER=[Gmail]/Spam

# Mark summarized mail as read so it stops reappearing. Important mail
# (needs-a-reply / high priority) always stays unread. Set false to disable.
# MARK_READ=true
